{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/go-docker.sh:*)",
      "Bash(./scripts/validate-infra.sh)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose run --rm seed)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(python3 scripts/list-endpoints.py:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Bash(docker compose down -v:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(helm uninstall:*)"
    ]
  }
}
