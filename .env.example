# =============================================================================
# InnKeep — variáveis de ambiente para DESENVOLVIMENTO LOCAL
#
# Copie este arquivo para ".env" (que está no .gitignore) e ajuste se quiser:
#
#     cp .env.example .env
#
# Os valores abaixo são padrões públicos, bons apenas para rodar na sua
# máquina. NUNCA os use em produção: em produção cada segredo é gerado e
# guardado em um cofre (AWS Secrets Manager) — veja docs/guides/deploy-producao.md.
# =============================================================================

# ---- PostgreSQL --------------------------------------------------------------
# Senha do superusuário (usado só para criar os bancos na primeira subida).
POSTGRES_PASSWORD=postgres_dev
# Senha dos usuários de cada serviço (um banco e um usuário por serviço).
POSTGRES_SERVICE_PASSWORD=innkeep_dev

# ---- Administrador inicial ---------------------------------------------------
# Criado na primeira subida, quando ainda não existe nenhum usuário.
BOOTSTRAP_ADMIN_EMAIL=admin@innkeep.local
BOOTSTRAP_ADMIN_PASSWORD=innkeep-dev-admin

# ---- Chaves criptográficas ---------------------------------------------------
# Em desenvolvimento podem ficar vazias: os serviços usam chaves de exemplo e
# avisam no log. Em produção são obrigatórias.
#
# Chave de assinatura dos JWT (Ed25519). Gere com:
#   docker compose run --rm identity keygen
JWT_PRIVATE_KEY=
# Chave dos dados pessoais dos hóspedes (CPF, passaporte). Gere com:
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=
# Chave das credenciais dos canais de venda. Gere com:
#   openssl rand -base64 32
CHANNEL_ENCRYPTION_KEY=

# ---- Endereços públicos ------------------------------------------------------
# Como o NAVEGADOR enxerga o site e a API (usados em links e e-mails).
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# ---- Geral -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
# Fuso usado como "hoje" nos lançamentos financeiros e fichas de hóspedes.
APP_TIMEZONE=America/Sao_Paulo
